[Desktop Entry]
Type=Application
Name=Criar atalho (Proton)
GenericName=Atalho de programa do Windows
Comment=Cria um atalho no menu e/ou na área de trabalho para este .exe, sem executar
Exec=cisma-exe --shortcut %f
Icon=applications-games
Terminal=false
NoDisplay=true
StartupNotify=false
Categories=Game;
MimeType=application/vnd.microsoft.portable-executable;application/x-msdownload;application/x-dosexec;application/x-ms-dos-executable;application/x-ms-ne-executable;application/x-msi;application/x-bat;application/bat;
