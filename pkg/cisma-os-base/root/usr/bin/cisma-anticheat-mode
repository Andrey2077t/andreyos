#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""Assistente de diagnóstico para VFIO, libvirt e Looking Glass."""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/cisma-os")
import cisma_anticheat as A  # noqa: E402

TITLE = "AntiCheat Mode — Cisma OS"


def zenity(*args):
    try:
        p = subprocess.run(["zenity", "--no-markup", "--title=" + TITLE, *args], capture_output=True, text=True)
        return p.returncode, p.stdout.strip()
    except OSError:
        return 1, ""


def show(text):
    try:
        subprocess.run(["zenity", "--text-info", "--title=" + TITLE, "--width=760", "--height=560",
                        "--font=monospace"], input=text, text=True)
    except OSError:
        print(text)


def select_vm(action):
    vms = A.list_vms()
    if not vms:
        zenity("--warning", "--width=460", "--text=Nenhuma VM libvirt foi encontrada. Configure uma VM Windows no virt-manager primeiro.")
        return
    args = ["--list", "--width=520", "--height=360", "--column=VM", "--text=Escolha a máquina virtual"]
    args.extend(vms)
    rc, name = zenity(*args)
    if rc or name not in vms:
        return
    verb = "iniciar" if action == "start" else "desligar"
    rc, _ = zenity("--question", "--width=460", "--text=Confirma " + verb + " a VM '" + name + "'?")
    if rc:
        return
    result = A.vm_action(name, action)
    if result.returncode == 0:
        zenity("--info", "--width=460", "--text=Comando enviado à VM '" + name + "'.")
    else:
        zenity("--error", "--width=560", "--text=" + (result.stderr.strip() or "O libvirt não conseguiu executar a ação."))


def apply_vfio():
    state = A.inspect_system()
    show(A.render_report(state))
    candidates = [gpu for gpu in state["gpus"] if not gpu["in_use"]]
    if not candidates:
        zenity("--error", "--width=560", "--text=Nenhuma GPU dedicada livre foi encontrada. A GPU ativa nunca pode ser isolada.")
        return
    args = ["--list", "--width=760", "--height=360", "--column=PCI", "--column=GPU", "--column=grupo IOMMU",
            "--text=Escolha somente uma GPU dedicada. A GPU em uso foi removida desta lista."]
    vendors = {"0x10de": "NVIDIA", "0x1002": "AMD", "0x8086": "Intel"}
    for gpu in candidates:
        label = "{0} {1}:{2} ({3}, driver {4})".format(
            vendors.get(gpu["vendor"], "GPU"), gpu["vendor"], gpu["device"], gpu["pci"], gpu["driver"])
        args.extend((gpu["pci"], label, str(gpu.get("iommu_group") or "sem grupo")))
    rc, target = zenity(*args)
    if rc or target not in [gpu["pci"] for gpu in candidates]:
        return

    options = []
    if set(state.get("video_alternatives", [])) - {target}:
        options.append(("FALSE", "iGPU/segunda GPU disponível; confirme monitor ligado nela"))
    if state.get("ssh_recovery"):
        options.append(("FALSE", "SSH ativo; confirme que você sabe o IP e consegue acessar"))
    options.append(("FALSE", "Live USB inicializável pronto para recuperação"))
    checklist = ["--checklist", "--width=720", "--height=340", "--print-column=2", "--separator=\n",
                 "--column=ok", "--column=rota de recuperação", "--text=Confirme ao menos uma rota de recuperação testada."]
    for checked, label in options:
        checklist.extend((checked, label))
    rc, recovery = zenity(*checklist)
    if rc or not recovery:
        zenity("--warning", "--width=520", "--text=A configuração foi cancelada: sem rota de recuperação confirmada.")
        return
    check = A.preflight(state, target, recovery_confirmed=True)
    if check["group"]:
        detail = "Grupo IOMMU {0}:\n".format(check["group"]["id"])
        detail += "\n".join("{pci}  {vendor}:{device}  classe={class} driver={driver}".format(
            pci=d.get("pci", "?"), vendor=d.get("vendor", "?"), device=d.get("device", "?"),
            **{"class": d.get("class", "?")}, driver=d.get("driver", "desconhecido"))
                              for d in check["group"]["devices"])
    else:
        detail = "Nenhum grupo IOMMU contém esta GPU."
    params = state["iommu_kernel_params"]
    detail += "\n\nParâmetros que serão acrescentados ao GRUB: " + " ".join(params)
    detail += "\nA GPU continuará usando o driver do Cisma OS no boot; o bind ao VFIO será sob demanda."
    if check["blockers"]:
        zenity("--error", "--width=720", "--text=Não é seguro aplicar.\n\n" + "\n".join(check["blockers"]) + "\n\n" + detail)
        return
    if check["warnings"]:
        rc, _ = zenity("--warning", "--width=720", "--text=Revise os avisos:\n\n" + "\n".join(check["warnings"]) +
                       "\n\n" + detail)
        if rc:
            return
    message = ("Vai editar GRUB e initramfs para a GPU {0}.\n\n{1}\n\nRota de recuperação confirmada: {2}\n\n"
               "Um backup exato e scripts bind/unbind/reverter serão criados.\n"
               "Após aplicar, reinicie para ativar. A GPU selecionada não pode estar em uso.\n\n"
               "Confirmo que a rota de recuperação selecionada funciona e quero continuar?").format(target, detail, recovery)
    rc, _ = zenity("--question", "--width=720", "--text=" + message)
    if rc:
        return
    result = subprocess.run(["pkexec", "/usr/lib/cisma-os/vfio-helper", "apply", target, "--confirmed-recovery"],
                            capture_output=True, text=True)
    if result.returncode:
        zenity("--error", "--width=720", "--text=" + (result.stderr.strip() or "A configuração VFIO não foi aplicada."))
        return
    rc, _ = zenity("--question", "--width=620", "--text=" + result.stdout.strip() + "\n\nDeseja reiniciar agora?")
    if rc == 0:
        subprocess.run(["systemctl", "reboot"], check=False)


def gui():
    while True:
        rc, action = zenity("--list", "--width=650", "--height=360", "--column=ação", "--column=descrição",
                            "--hide-header", "--text=Assistente VFIO + Looking Glass. Sem ocultar VMs nem alterar o boot.",
                            "check", "Diagnosticar IOMMU, GPUs, libvirt e Looking Glass",
                            "plan", "Gerar plano personalizado (sem aplicar alterações)",
                            "apply", "Configurar VFIO (pré-verificação e confirmação obrigatórias)",
                            "bind", "Preparar GPU para uma VM desligada",
                            "unbind", "Devolver GPU ao driver do Cisma OS",
                            "revert", "Reverter configuração VFIO e restaurar backups",
                            "start", "Iniciar uma VM Windows configurada",
                            "stop", "Desligar uma VM Windows configurada",
                            "virt", "Abrir virt-manager")
        if rc:
            return 0
        state = A.inspect_system()
        if action == "check":
            show(A.render_report(state))
        elif action == "plan":
            text = A.setup_plan(state)
            path = A.save_plan(text)
            show(text + "\n\nPlano salvo em:\n" + path)
        elif action == "apply":
            apply_vfio()
        elif action in ("bind", "unbind"):
            if action == "bind":
                text = "Preparar os dispositivos PCI reservados para VFIO? Desligue a VM antes de usar esta ação."
            else:
                text = "Devolver a GPU ao driver do Cisma OS? A VM precisa estar desligada."
            rc, _ = zenity("--question", "--width=560", "--text=" + text)
            if rc == 0:
                command = "bind" if action == "bind" else "unbind"
                result = subprocess.run(["pkexec", "/usr/lib/cisma-os/vfio-helper", command],
                                        capture_output=True, text=True)
                (zenity("--info" if result.returncode == 0 else "--error", "--width=560",
                         "--text=" + (result.stdout.strip() if result.returncode == 0 else result.stderr.strip())))
        elif action == "revert":
            rc, _ = zenity("--question", "--width=650", "--text=Restaurar os backups de GRUB/modprobe/initramfs e remover os scripts VFIO? A reversão exige reiniciar para restaurar os drivers.")
            if rc == 0:
                result = subprocess.run(["pkexec", "/usr/lib/cisma-os/vfio-helper", "revert"],
                                        capture_output=True, text=True)
                if result.returncode:
                    zenity("--error", "--width=620", "--text=" + result.stderr.strip())
                else:
                    rc, _ = zenity("--question", "--width=620", "--text=" + result.stdout.strip() + "\n\nReiniciar agora?")
                    if rc == 0:
                        subprocess.run(["systemctl", "reboot"], check=False)
        elif action == "start":
            select_vm("start")
        elif action == "stop":
            select_vm("shutdown")
        elif action == "virt":
            if not state["tools"]["virt_manager"]:
                zenity("--warning", "--width=520", "--text=virt-manager não está instalado. Consulte o plano VFIO para os pacotes recomendados.")
            else:
                subprocess.Popen(["virt-manager"], start_new_session=True)


def main(argv):
    state = A.inspect_system()
    if "--check" in argv:
        print(A.render_report(state))
    elif "--plan" in argv:
        text = A.setup_plan(state)
        if "--save" in argv:
            print(A.save_plan(text))
        else:
            print(text)
    elif "--apply" in argv:
        print("A configuração VFIO só pode ser aplicada pelo assistente gráfico após selecionar a GPU, confirmar o grupo IOMMU e uma rota de recuperação.")
        return 2
    elif argv:
        print("Uso: cisma-anticheat-mode [--check | --plan [--save]]")
        return 2
    else:
        return gui()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
