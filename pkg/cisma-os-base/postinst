#!/bin/sh
# Roda na instalacao e em toda atualizacao do cisma-os-base.
set -e

case "$1" in
configure)
    # Migra as fontes do repositorio assinado da edicao anterior sem tocar no dominio remoto.
    rm -f /etc/apt/sources.list.d/andrey-os.list
    rm -f /usr/share/keyrings/andrey-os.gpg
    # Remove atalhos/binarios antigos do CismaCam em sistemas atualizados.
    rm -f /usr/bin/cismacam /usr/share/applications/cismacam.desktop

    # versao do pacote -> os-release, issue, motd (sempre iguais ao que foi publicado)
    /usr/lib/cisma-os/sync-version || true

    # padroes do MATE (gschema override) e layout dos paineis
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || echo "cisma-os-base: aviso: glib-compile-schemas falhou" >&2

    # icones "cisma-*" tambem no hicolor (qualquer tema os encontra) + caches
    mkdir -p /usr/share/icons/hicolor/scalable/apps
    cp -f /usr/share/icons/Cisma/scalable/apps/cisma-*.svg /usr/share/icons/hicolor/scalable/apps/ 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/Cisma 2>/dev/null || true

    # Jogos: vm.max_map_count alto (Steam/Proton) ja valendo, sem esperar o proximo boot
    if [ -f /usr/lib/sysctl.d/80-cisma-games.conf ] && command -v sysctl >/dev/null 2>&1; then
        sysctl -q -p /usr/lib/sysctl.d/80-cisma-games.conf 2>/dev/null || true
    fi

    # Plymouth: tema "cisma"
    if command -v plymouth-set-default-theme >/dev/null 2>&1 && [ -f /usr/share/plymouth/themes/cisma/cisma.plymouth ]; then
        plymouth-set-default-theme -R cisma 2>/dev/null || true
    fi

    # Calamares: nome, cores e logo no branding existente (idempotente; ignora se nao houver)
    CB=$(find /etc/calamares /usr/share/calamares -maxdepth 3 -name branding.desc 2>/dev/null | head -1 || true)
    if [ -n "$CB" ]; then
        CD=$(dirname "$CB")
        for k in productName shortProductName versionedName shortVersionedName bootloaderEntryName; do
            sed -i "s|^\( *$k: *\).*|\1Cisma OS|" "$CB" || true
        done
        sed -i 's|^\( *version: *\).*|\11.0|; s|^\( *shortVersion: *\).*|\11.0|' "$CB" || true
        # as chaves de estilo do Calamares comecam com maiuscula (SidebarBackground); aceita as duas
        sed -i 's|^\( *[Ss]idebarBackground: *\).*|\1"#0b0306"|; s|^\( *[Ss]idebarText: *\).*|\1"#ededf0"|; s|^\( *[Ss]idebarTextSelect: *\).*|\1"#ffffff"|; s|^\( *[Ss]idebarTextHighlight: *\).*|\1"#ed1226"|' "$CB" || true
        LOGO=/usr/share/cisma-os/calamares/logo.png
        if [ -f "$LOGO" ]; then
            for k in productLogo productIcon; do
                f=$(sed -n "s|^ *$k: *[\"']\{0,1\}\([^\"' ]*\)[\"']\{0,1\} *\$|\1|p" "$CB" | head -1 || true)
                case "$f" in *.png) cp -f "$LOGO" "$CD/$f" 2>/dev/null || true ;; esac
            done
        fi
    fi

    # Calamares: se o dicionario de senhas falhar, a pessoa pode marcar "aceitar senha fraca"
    # (sem isso o botao Proximo fica travado). O dicionario em si vem do cracklib-runtime/wamerican.
    CU=$(find /etc/calamares -maxdepth 3 -name users.conf 2>/dev/null | head -1 || true)
    if [ -n "$CU" ]; then
        sed -i 's|^\( *allowWeakPasswords: *\).*|\1true|' "$CU" || true
    fi

    # Bluetooth: padroes do bluetoothd (liga sozinho, repareia fone/mouse barato), regras de udev novas e
    # grupo "bluetooth" para quem ja tinha conta (contas novas: cisma-firstboot e Calamares)
    [ -x /usr/lib/cisma-os/bluetooth-helper ] && /usr/lib/cisma-os/bluetooth-helper defaults || true
    udevadm control --reload 2>/dev/null || true
    if getent group bluetooth >/dev/null 2>&1; then
        for u in $(getent passwd | awk -F: '$3>=1000 && $3<60000 {print $1}'); do
            usermod -aG bluetooth "$u" 2>/dev/null || true
        done
    fi
    # Calamares: a conta criada na instalacao entra no grupo bluetooth (respeita a indentacao da lista)
    if [ -n "$CU" ] && ! grep -q 'bluetooth' "$CU"; then
        awk '/^defaultGroups:[ \t]*$/ { print; if ((getline nxt) > 0) { match(nxt, /^[ \t]*-[ \t]*/); if (RSTART) print substr(nxt, RSTART, RLENGTH) "bluetooth"; print nxt }; next } { print }' \
            "$CU" > "$CU.cisma" && mv "$CU.cisma" "$CU" || rm -f "$CU.cisma"
    fi
    ;;
esac

exit 0
