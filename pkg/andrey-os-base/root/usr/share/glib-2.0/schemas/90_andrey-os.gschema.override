[org.mate.background]
picture-filename='/usr/share/backgrounds/andrey/andrey-os.png'
picture-options='zoom'
primary-color='#030002'

[org.mate.interface]
gtk-theme='Adwaita-dark'
icon-theme='Andrey'
font-name='Inter 10'
document-font-name='Inter 10'

[org.mate.Marco.general]
theme='Adwaita-dark'
titlebar-font='Inter Bold 10'
compositing-manager=true

[org.mate.panel]
default-layout='andrey'

[org.mate.panel.applet.clock]
format='custom'
custom-format='%a, %d de %b  •  %H:%M'

# ---- atalhos de janela estilo Windows (Super+D, Super+setas) ----
[org.mate.Marco.global-keybindings]
show-desktop='<Super>d'

[org.mate.Marco.window-keybindings]
maximize='<Super>Up'
unmaximize='<Super>Down'
tile-to-side-w='<Super>Left'
tile-to-side-e='<Super>Right'

# ---- touchpad: tocar para clicar (como no notebook com Windows) ----
[org.mate.peripherals-touchpad]
tap-to-click=true

# ---- volume: quem trata as teclas e o andrey-volume (atalhos em andrey-keys), sem tratar duas vezes ----
[org.mate.SettingsDaemon.plugins.media-keys]
volume-up='disabled'
volume-down='disabled'
volume-mute='disabled'
