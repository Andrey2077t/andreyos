# ===================== barra superior =====================
[Toplevel top]
expand=true
orientation=top
size=32

[Object menu-bar]
object-type=menu-bar
toplevel-id=top
position=0
locked=true

[Object show-desktop]
object-type=applet
applet-iid=WnckletFactory::ShowDesktopApplet
toplevel-id=top
position=0
panel-right-stick=true

[Object clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=top
position=34
panel-right-stick=true

[Object notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=top
position=224
panel-right-stick=true

# lista de janelas abertas (a "barra de tarefas"): ocupa o espaco livre da barra superior
[Object window-list]
object-type=applet
applet-iid=WnckletFactory::WindowListApplet
toplevel-id=top
position=360

# ===================== dock inferior =====================
[Toplevel bottom]
expand=false
orientation=bottom
size=56
x-centered=true
y-bottom=10

[Object bottom-browser]
object-type=launcher
launcher-location=firefox-esr.desktop
toplevel-id=bottom
position=56

[Object bottom-terminal]
object-type=launcher
launcher-location=andrey-terminal.desktop
toplevel-id=bottom
position=112

[Object bottom-files]
object-type=launcher
launcher-location=andrey-files.desktop
toplevel-id=bottom
position=168

[Object bottom-settings]
object-type=launcher
launcher-location=andrey-settings.desktop
toplevel-id=bottom
position=224

[Object bottom-separator]
object-type=separator
toplevel-id=bottom
position=280

# ===================== objetos "menu" e "action" (por último) =====================
[Object bottom-grid]
object-type=launcher
launcher-location=andrey-start.desktop
toplevel-id=bottom
position=0

# ===================== lixeira (applet do pacote mate-applets, dependencia do andrey-os-base) =====================
[Object bottom-trash]
object-type=applet
applet-iid=TrashAppletFactory::TrashApplet
toplevel-id=bottom
position=296

# ===================== desligar (antes ficava no dock lateral, agora no fim do dock de baixo) =====================
[Object bottom-power]
object-type=action
action-type=shutdown
toplevel-id=bottom
position=352
