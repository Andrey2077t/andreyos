# ===================== barra superior =====================
[Toplevel top]
expand=true
orientation=top
size=32

[Object menu-bar]
object-type=menu-bar
toplevel-id=top
position=0
locked=true

[Object clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=top
position=0
panel-right-stick=true

[Object notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=top
position=190
panel-right-stick=true

# ===================== dock lateral esquerdo =====================
[Toplevel left]
expand=false
orientation=left
size=56
x=8
y-centered=true

[Object left-files]
object-type=launcher
launcher-location=andrey-files.desktop
toplevel-id=left
position=56

[Object left-browser]
object-type=launcher
launcher-location=firefox-esr.desktop
toplevel-id=left
position=112

[Object left-terminal]
object-type=launcher
launcher-location=andrey-terminal.desktop
toplevel-id=left
position=168

[Object left-monitor]
object-type=launcher
launcher-location=andrey-monitor.desktop
toplevel-id=left
position=224

[Object left-settings]
object-type=launcher
launcher-location=andrey-settings.desktop
toplevel-id=left
position=280

[Object left-separator]
object-type=separator
toplevel-id=left
position=336

# ===================== dock inferior =====================
[Toplevel bottom]
expand=false
orientation=bottom
size=56
x-centered=true
y-bottom=10

[Object bottom-browser]
object-type=launcher
launcher-location=firefox-esr.desktop
toplevel-id=bottom
position=56

[Object bottom-terminal]
object-type=launcher
launcher-location=andrey-terminal.desktop
toplevel-id=bottom
position=112

[Object bottom-files]
object-type=launcher
launcher-location=andrey-files.desktop
toplevel-id=bottom
position=168

[Object bottom-settings]
object-type=launcher
launcher-location=andrey-settings.desktop
toplevel-id=bottom
position=224

[Object bottom-separator]
object-type=separator
toplevel-id=bottom
position=280

# ===================== objetos "menu" e "action" (por último) =====================
[Object left-grid]
object-type=menu
toplevel-id=left
position=0
tooltip=Aplicativos
use-custom-icon=true
custom-icon=andrey-grid
use-menu-path=true
menu-path=applications:///

[Object left-power]
object-type=action
action-type=shutdown
toplevel-id=left
position=348

[Object bottom-grid]
object-type=menu
toplevel-id=bottom
position=0
tooltip=Aplicativos
use-custom-icon=true
custom-icon=andrey-grid
use-menu-path=true
menu-path=applications:///

# ===================== lixeira (applet do pacote mate-applets, dependencia do andrey-os-base) =====================
[Object bottom-trash]
object-type=applet
applet-iid=TrashAppletFactory::TrashApplet
toplevel-id=bottom
position=296
