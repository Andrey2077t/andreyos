#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""Loja de Aplicativos do Andrey OS: instalar e remover programas com um clique.

  andrey-store            abre a loja (catálogo + busca em todos os pacotes do Debian)
  andrey-store ARQ.deb    instala um arquivo .deb baixado (duplo clique no arquivo)
"""
import os
import subprocess
import sys
import threading
import urllib.request

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

HELPER = "/usr/lib/andrey-os/apt-helper"

# (nome, descrição, categoria, pacotes apt, extras)  extras: i386=True | url="..." (baixa o .deb oficial)
