#!/bin/bash
# Roda como root (via pkexec): atualiza somente o repositorio do Andrey OS e o pacote andrey-os-base.
set -e
export DEBIAN_FRONTEND=noninteractive
LIST=/etc/apt/sources.list.d/andrey-os.list
apt-get update -o Dir::Etc::sourcelist="$LIST" -o Dir::Etc::sourceparts="-" -o APT::Get::List-Cleanup="0"
apt-get install -y --only-upgrade -o Dpkg::Options::=--force-confnew andrey-os-base
