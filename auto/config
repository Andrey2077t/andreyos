#!/bin/sh
# Configuração do live-build para o Cisma OS (base: Debian 13 "trixie" + MATE)
set -e

lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --parent-archive-areas "main contrib non-free non-free-firmware" \
    --firmware-chroot true \
    --linux-flavours amd64 \
    --binary-images iso-hybrid \
    --bootloaders "grub-pc,grub-efi" \
    --debian-installer none \
    --iso-application "Cisma OS" \
    --iso-publisher "Cisma" \
    --iso-volume "CISMA_OS" \
    --image-name "cisma-os" \
    --bootappend-live "boot=live quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo hostname=cisma-os nocomponents=user-setup,sudo,lightdm" \
    --apt-recommends false \
    --memtest none \
    "${@}"
