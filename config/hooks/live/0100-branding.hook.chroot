#!/bin/sh
# Identidade do sistema: os-release, issue, motd
set -e

cat > /etc/os-release <<'EOF'
PRETTY_NAME="Andrey OS"
NAME="Andrey OS"
VERSION_ID="1.0"
VERSION="1.0 (Supere os limites)"
VERSION_CODENAME=trixie
ID=andrey-os
ID_LIKE=debian
HOME_URL="https://example.com/andrey-os"
EOF

printf 'Andrey OS 1.0 \\n \\l\n\n' > /etc/issue
printf 'Andrey OS 1.0\n' > /etc/issue.net
printf '\n  ANDREY OS — Velocidade • Performance • Desempenho\n\n' > /etc/motd

echo "andrey-os" > /etc/hostname

# locale / teclado / fuso padrão
sed -i 's/^# *pt_BR.UTF-8 UTF-8/pt_BR.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
update-locale LANG=pt_BR.UTF-8
ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
