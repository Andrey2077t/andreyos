#!/bin/sh
# Jogos: arquitetura i386, Steam, Wine e as bibliotecas de 32 bits que os dois precisam.
# (Proton vem do proprio Steam, via Steam Play; o "andrey-games" instala o Proton-GE e diagnostica.)
# Roda depois do andrey-os-base (0050) e antes da trava de drivers (0200).
#
# Por que num hook e nao em config/package-lists: pacotes :i386 so existem depois de
# "dpkg --add-architecture i386", e o steam-installer pergunta a licenca via debconf (precisa de preseed).
set -e
export DEBIAN_FRONTEND=noninteractive

dpkg --add-architecture i386
apt-get update

# Licenca do pacote steam-installer (o Steam ainda mostra a licenca da Valve no primeiro uso)
echo "steam steam/question select I AGREE" | debconf-set-selections
echo "steam steam/license note" | debconf-set-selections

# --- obrigatorios: se faltar algum, o build para (melhor que entregar ISO sem Steam/Wine) ----------
CORE="steam-installer wine wine32:i386 libwine:i386 \
      mesa-vulkan-drivers:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386 libvulkan1:i386 libvulkan1"
# shellcheck disable=SC2086
apt-get install -y --no-install-recommends $CORE

# --- opcionais: entram so se existirem no trixie (nome muda entre versoes do Debian) ----------------
OPTIONAL="wine64 libwine fonts-wine winetricks cabextract winbind \
          steam-devices gamemode libgamemode0:i386 mangohud \
          libpulse0:i386 libasound2-plugins:i386 libgnutls30t64:i386 libsdl2-2.0-0:i386 libfreetype6:i386 \
          libnss3:i386 libxcomposite1:i386 libxrandr2:i386 libxinerama1:i386 libxcursor1:i386 libxi6:i386 \
          libudev1:i386 libusb-1.0-0:i386 libopenal1:i386 libgbm1:i386 libegl1:i386 libgl1:i386"
WANT=""
for p in $OPTIONAL; do
    cand=$(apt-cache policy "$p" 2>/dev/null | awk '/Candidate:/ {print $2}')
    if [ -n "$cand" ] && [ "$cand" != "(none)" ]; then
        WANT="$WANT $p"
    else
        echo "AVISO: pacote opcional '$p' nao existe no trixie; ignorado." >&2
    fi
done
if [ -n "$WANT" ]; then
    # shellcheck disable=SC2086
    apt-get install -y --no-install-recommends $WANT || \
        echo "AVISO: alguns pacotes opcionais de jogos nao instalaram; o 'andrey-games' acusa o que faltar." >&2
fi

# --- travas de build -----------------------------------------------------------------------------
for pkg in steam-installer wine wine32:i386 libwine:i386 mesa-vulkan-drivers:i386 libgl1-mesa-dri:i386 libvulkan1:i386; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || {
        echo "ERRO: pacote '$pkg' ausente na imagem (Steam/Wine)." >&2; exit 1; }
done
dpkg --print-foreign-architectures | grep -qx i386 || { echo "ERRO: i386 nao ficou habilitada." >&2; exit 1; }
for f in /usr/bin/andrey-games /usr/lib/andrey-os/andrey_games.py /usr/lib/sysctl.d/80-andrey-games.conf; do
    [ -e "$f" ] || { echo "ERRO: $f ausente depois de instalar o andrey-os-base." >&2; exit 1; }
done
command -v steam >/dev/null 2>&1 || { echo "ERRO: comando 'steam' ausente." >&2; exit 1; }
command -v wine  >/dev/null 2>&1 || { echo "ERRO: comando 'wine' ausente." >&2; exit 1; }

# a ISO nao precisa carregar o cache dos .deb de 32 bits (o live-build limpa os indices depois)
apt-get clean
exit 0
