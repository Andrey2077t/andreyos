#!/bin/sh
# Padrões do desktop (MATE) via gschema override + layout do painel
set -e

cat > /usr/share/glib-2.0/schemas/90_andrey-os.gschema.override <<'EOF'
[org.mate.background]
picture-filename='/usr/share/backgrounds/andrey/andrey-os.png'
picture-options='zoom'
primary-color='#030002'

[org.mate.interface]
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'
font-name='Inter 10'
document-font-name='Inter 10'

[org.mate.Marco.general]
theme='Adwaita-dark'
titlebar-font='Inter Bold 10'

[org.mate.panel]
default-layout='andrey'

[org.mate.panel.applet.clock]
format='custom'
custom-format='%a, %d de %b  •  %H:%M'
EOF
glib-compile-schemas /usr/share/glib-2.0/schemas/

# Layout do painel: barra superior (Aplicativos/Locais/Sistema, relógio, bandeja)
# + dock inferior centralizado com lançadores.
mkdir -p /usr/share/mate-panel/layouts
cat > /usr/share/mate-panel/layouts/andrey.layout <<'EOF'
[Toplevel top]
expand=true
orientation=top
size=32

[Object menu-bar]
object-type=menu-bar
toplevel-id=top
position=0

[Object top-spacer-left]
object-type=applet
applet-iid=WnckletFactory::ShowDesktopApplet
toplevel-id=top
pack-type=start
position=40

[Object clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=top
pack-type=center
position=0

[Object notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=top
pack-type=end
position=0

[Toplevel bottom]
expand=false
orientation=bottom
size=56
x-centered=true
y-bottom=true

[Object launcher-browser]
object-type=launcher
launcher-location=firefox-esr.desktop
toplevel-id=bottom
position=0

[Object launcher-terminal]
object-type=launcher
launcher-location=mate-terminal.desktop
toplevel-id=bottom
position=1

[Object launcher-files]
object-type=launcher
launcher-location=caja.desktop
toplevel-id=bottom
position=2

[Object launcher-settings]
object-type=launcher
launcher-location=mate-control-center.desktop
toplevel-id=bottom
position=3

[Object launcher-monitor]
object-type=launcher
launcher-location=mate-system-monitor.desktop
toplevel-id=bottom
position=4

[Object trash]
object-type=applet
applet-iid=TrashAppletFactory::TrashApplet
toplevel-id=bottom
position=5
EOF
