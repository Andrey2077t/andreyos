#!/bin/sh
# Instala o pacote cisma-os-base (visual, paineis, icones, atualizador) embutido na ISO.
# Roda antes dos outros hooks, quando todos os pacotes das listas ja foram instalados.
set -e

DEB=$(ls /usr/share/cisma-os/pkg/cisma-os-base_*.deb 2>/dev/null | sort -V | tail -1 || true)
[ -n "$DEB" ] || { echo "ERRO: cisma-os-base_*.deb ausente em /usr/share/cisma-os/pkg" >&2; exit 1; }

DEBIAN_FRONTEND=noninteractive dpkg -i "$DEB" || {
    echo "dpkg -i falhou; tentando corrigir dependencias" >&2
    DEBIAN_FRONTEND=noninteractive apt-get install -y -f
}

dpkg-query -W -f='${Status}' cisma-os-base 2>/dev/null | grep -q 'install ok installed' || {
    echo "ERRO: cisma-os-base nao ficou instalado." >&2; exit 1; }
for f in /usr/share/mate-panel/layouts/cisma.layout /usr/share/icons/Cisma/index.theme \
         /usr/share/backgrounds/cisma/cisma-os.png /usr/bin/cisma-update /usr/bin/cisma-uninstall /usr/bin/cisma-volume-osd \
         /usr/bin/cisma-music /usr/share/applications/cisma-music.desktop /usr/share/icons/Cisma/scalable/apps/cisma-music.svg \
         /usr/bin/cisma-code /usr/share/applications/cisma-code.desktop /usr/share/icons/Cisma/scalable/apps/cisma-code.svg \
         /usr/bin/cisma-share /usr/share/applications/cisma-share.desktop /usr/share/icons/Cisma/scalable/apps/cisma-share.svg \
         /usr/bin/cisma-session-profiles /usr/share/applications/cisma-session-profiles.desktop /usr/share/icons/Cisma/scalable/apps/cisma-session-profiles.svg \
         /usr/share/backgrounds/cisma/cisma-os-focus.png; do
    [ -e "$f" ] || { echo "ERRO: $f ausente depois de instalar o cisma-os-base." >&2; exit 1; }
done

# o .deb nao precisa ficar dentro do sistema final
rm -rf /usr/share/cisma-os/pkg
